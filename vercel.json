{
  "outputDirectory": "output/preview",
  "rewrites": [
    {
      "source": "/",
      "destination": "/report_144.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
